# Endereço público do site, sem barra no final. Usado em links de WhatsApp, SEO e e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endereço público lido com o servidor rodando. Na Railway, sem domínio próprio, não é preciso definir.
SITE_URL=

# Banco de dados. Local: arquivo SQLite. Produção: mesmo arquivo em disco persistente, ou Turso (libsql://...).
DATABASE_URL=file:./data/vitrine.db
# Apenas para Turso:
DATABASE_AUTH_TOKEN=

# Armazenamento de arquivos: "local" (disco) ou "s3" (Cloudflare R2, Supabase Storage, AWS S3...).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endereço público do bucket, sem barra no final.
S3_PUBLIC_URL=

# Primeiro administrador, criado quando ainda não existe nenhum usuário. Em produção, a senha precisa de 12 caracteres ou mais.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Envio do e-mail de recuperação de senha (https://resend.com). Sem isso, o link aparece no log do servidor.
RESEND_API_KEY=
EMAIL_FROM=
